# Forgejo Runner Configuration (.env)
# Copy this file to .env and fill in your registration token:
#   cp .env.example .env

# Required: Token copied from Forgejo UI (Site Admin -> Actions -> Runners -> Create new Runner)
FORGEJO_RUNNER_TOKEN=

# Forgejo instance URL accessible from the runner container
FORGEJO_URL=http://forgejo:3000/

# Optional: Specific Runner UUID (if left unset, template_runner_config.py generates or preserves one)
# FORGEJO_RUNNER_UUID=

# Runner tags/labels (comma-separated)
# RUNNER_LABELS=host:host

# Number of concurrent jobs to handle
# RUNNER_CAPACITY=1
