#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="forgejo.compose.yml"
IMAGE="forgejo-runner:custom"

case "${1:-start}" in
  start)
    echo "Building Forgejo runner image..."
    podman build \
      -t "$IMAGE" \
      -f runner.Dockerfile \
      .

    echo "Starting Podman Compose..."
    podman compose \
      -f "$COMPOSE_FILE" \
      up -d
    ;;

  stop)
    echo "Stopping Forgejo..."
    podman compose \
      -f "$COMPOSE_FILE" \
      down
    ;;

  status)
    echo "Forgejo status:"
    podman compose \
      -f "$COMPOSE_FILE" \
      ps
    ;;

  *)
    echo "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
