#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="forgejo.compose.yml"
IMAGE="forgejo-runner:custom"

case "${1:-start}" in
  start)
    echo "Ensuring Podman network 'proxy-nw' exists..."
    podman network exists proxy-nw || podman network create proxy-nw

    if [ ! -f "data/forgejo-runner/runner-config.yml" ]; then
      echo "WARNING: 'data/forgejo-runner/runner-config.yml' not found."
      echo "Forgejo runner will fail until configured."
      echo "Generate it using: python3 scripts/template_runner_config.py --token <TOKEN>"
    fi

    echo "Building Forgejo runner image..."
    podman build \
      -t "$IMAGE" \
      -f runner.Dockerfile \
      .

    echo "Starting Podman Compose..."
    podman compose \
      -f "$COMPOSE_FILE" \
      up -d
    ;;

  stop)
    echo "Stopping Forgejo..."
    podman compose \
      -f "$COMPOSE_FILE" \
      down
    ;;

  status)
    echo "Forgejo status:"
    podman compose \
      -f "$COMPOSE_FILE" \
      ps
    ;;

  *)
    echo "Usage: $0 {start|stop|status}"
    exit 1
    ;;
esac
